{% extends 'base.html.twig' %}

{% block title %}Mon tableau de bord - Je Demain{% endblock %}

{% block body %}
<div class="container" style="max-width: 1000px;">

    <div class="mb-4">
        <h1 class="fw-bold mb-1">Mon tableau de bord</h1>
        <p class="text-muted mb-0">Retrouvez ici vos besoins, vos propositions d'aide et vos solutions.</p>
    </div>

    <div class="row g-3 mb-5">
        <div class="col-6 col-md-4">
            <div class="card border-0 shadow-sm text-center" style="border-radius: 16px;">
                <div class="card-body">
                    <div class="h2 fw-bold mb-0" style="color: var(--primary-color);">{{ mesBesoins|length }}</div>
                    <div class="text-muted small text-uppercase">Besoins publiés</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="card border-0 shadow-sm text-center" style="border-radius: 16px;">
                <div class="card-body">
                    <div class="h2 fw-bold mb-0" style="color: var(--secondary-color);">{{ mesCandidatures|length }}</div>
                    <div class="text-muted small text-uppercase">Aides proposées</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm text-center" style="border-radius: 16px;">
                <div class="card-body">
                    <div class="h2 fw-bold mb-0" style="color: var(--accent-color);">{{ mesSolutions|length }}</div>
                    <div class="text-muted small text-uppercase">Solutions partagées</div>
                </div>
            </div>
        </div>
    </div>

    {# Mes besoins #}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 fw-bold mb-0"><i class="bi bi-chat-dots me-2" style="color: var(--primary-color);"></i>Mes besoins</h2>
        <a href="{{ path('app_nouveau_besoin') }}" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg me-1"></i>Nouveau besoin</a>
    </div>
    <div class="card border-0 shadow-sm mb-5" style="border-radius: 16px;">
        <div class="list-group list-group-flush" style="border-radius: 16px; overflow: hidden;">
            {% for besoin in mesBesoins %}
                <div class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <div class="fw-semibold">{{ besoin.Titre_Besoin }}</div>
                        <div class="small text-muted">
                            <i class="bi bi-calendar3 me-1"></i>{{ besoin.Date_Creation|date('d/m/Y') }}
                            <span class="mx-1">·</span>
                            <i class="bi bi-people me-1"></i>{{ besoin.nb_candidatures }} volontaire{{ besoin.nb_candidatures > 1 ? 's' : '' }}
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge rounded-pill {% if besoin.Statut == 'Ouvert' %}bg-success{% elseif besoin.Statut == 'En cours' %}bg-primary{% else %}bg-secondary{% endif %}">
                            {{ besoin.Statut }}
                        </span>
                        <a href="{{ path('app_besoins') }}" class="btn btn-sm btn-outline-secondary">Gérer</a>
                    </div>
                </div>
            {% else %}
                <div class="list-group-item text-center text-muted py-4">
                    Vous n'avez pas encore publié de besoin.
                </div>
            {% endfor %}
        </div>
    </div>

    {# Mes candidatures #}
    <h2 class="h4 fw-bold mb-3"><i class="bi bi-hand-thumbs-up me-2" style="color: var(--secondary-color);"></i>Mes propositions d'aide</h2>
    <div class="card border-0 shadow-sm mb-5" style="border-radius: 16px;">
        <div class="list-group list-group-flush" style="border-radius: 16px; overflow: hidden;">
            {% for c in mesCandidatures %}
                <div class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <div class="fw-semibold">{{ c.Titre_Besoin }}</div>
                        <div class="small text-muted"><i class="bi bi-calendar3 me-1"></i>Proposé le {{ c.date_candidature|date('d/m/Y') }}</div>
                    </div>
                    <div>
                        {% if c.maker_id == app.user.id and c.Statut == 'En cours' %}
                            <span class="badge rounded-pill bg-success"><i class="bi bi-check-circle me-1"></i>Vous avez été retenu</span>
                        {% elseif c.Statut == 'Terminé' %}
                            <span class="badge rounded-pill bg-secondary">Terminé</span>
                        {% else %}
                            <span class="badge rounded-pill bg-light text-dark border">En attente</span>
                        {% endif %}
                    </div>
                </div>
            {% else %}
                <div class="list-group-item text-center text-muted py-4">
                    Vous ne vous êtes proposé sur aucun besoin pour l'instant.
                    <a href="{{ path('app_besoins') }}" class="d-block mt-2">Parcourir les besoins</a>
                </div>
            {% endfor %}
        </div>
    </div>

    {# Mes solutions #}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 fw-bold mb-0"><i class="bi bi-lightbulb me-2" style="color: var(--accent-color);"></i>Mes solutions</h2>
        <a href="{{ path('app_nouvelle_solution') }}" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg me-1"></i>Nouvelle solution</a>
    </div>
    <div class="card border-0 shadow-sm" style="border-radius: 16px;">
        <div class="list-group list-group-flush" style="border-radius: 16px; overflow: hidden;">
            {% for s in mesSolutions %}
                <a href="{{ path('app_solution_detail', {id: s.SolutionID}) }}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <div class="fw-semibold">{{ s.Titre_Solution }}</div>
                        <div class="small text-muted"><i class="bi bi-calendar3 me-1"></i>{{ s.Date_Publication|date('d/m/Y') }}</div>
                    </div>
                    <span class="badge rounded-pill bg-light text-dark border">{{ s.Difficulte_Fabrication }}</span>
                </a>
            {% else %}
                <div class="list-group-item text-center text-muted py-4">
                    Vous n'avez pas encore partagé de solution.
                </div>
            {% endfor %}
        </div>
    </div>

</div>
{% endblock %}
