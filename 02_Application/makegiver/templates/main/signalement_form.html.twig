{% extends 'base.html.twig' %}

{% block title %}Signaler un contenu - Je Demain{% endblock %}

{% block body %}
<div class="container" style="max-width: 640px;">
    <div class="text-center mb-4">
        <span class="badge bg-danger-soft text-danger px-3 py-2 rounded-pill mb-3">MODÉRATION</span>
        <h1 class="display-6 fw-bold">Signaler un contenu</h1>
        <p class="text-muted">Aidez-nous à garder la communauté bienveillante. Votre signalement reste confidentiel.</p>
    </div>

    <div class="card border-0 shadow-sm" style="border-radius: 20px;">
        <div class="card-body p-4 p-md-5">
            {{ form_start(form) }}

                <div class="alert alert-light border d-flex align-items-center gap-2 mb-4" style="border-radius: 12px;">
                    <i class="bi bi-flag-fill text-danger"></i>
                    <span>Vous signalez <strong>{{ cible }}</strong>.</span>
                </div>

                {# Type et identifiant déterminés par le contexte : champs cachés #}
                {{ form_widget(form.typeContenu) }}
                {{ form_widget(form.contenuId) }}
                {{ form_errors(form.typeContenu) }}

                <div class="mb-4">
                    {{ form_label(form.raison, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                    {{ form_widget(form.raison, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.raison) }}
                </div>

                <div class="d-flex gap-2 justify-content-end">
                    <a href="{{ path('app_home') }}" class="btn btn-light">Annuler</a>
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-flag-fill me-1"></i> Envoyer le signalement
                    </button>
                </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
